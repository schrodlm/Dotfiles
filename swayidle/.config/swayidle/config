# swayidle config — sourced via `swayidle -C ~/.config/swayidle/config`
# Kept in its own file (not inline in sway config) so a sway reload doesn't
# restart the idle timer.
#
# Timers run sequentially:
#   600s idle  → lock screen
#   900s idle  → turn output off; on activity, turn it back on
#   on suspend → lock screen first

timeout 600 'swaylock -f'
timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
before-sleep 'swaylock -f'
# Loginctl integration: any tool calling `loginctl lock-session` triggers
# the lock hook.
lock 'swaylock -f'
unlock 'pkill -USR1 swaylock'
