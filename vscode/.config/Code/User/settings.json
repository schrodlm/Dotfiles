{
    "workbench.colorTheme": "Gruvbox Dark (Hard)",
    "C_Cpp.default.compilerPath": "/usr/bin/g++",
    "editor.fontSize": 16,
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "cmake.options.statusBarVisibility": "visible",
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.path": "/home/schrodlm/.config/Code/User/globalStorage/llvm-vs-code-extensions.vscode-clangd/install/19.1.2/clangd_19.1.2/bin/clangd",
    "security.workspace.trust.untrustedFiles": "open",
    "editor.fontFamily": "\"JetBrains Mono\", monospace",
    "platformio-ide.autoOpenPlatformIOIniFile": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "gitlens.gitCommands.skipConfirmations": [
        "fetch:command",
        "stash-push:command",
        "switch:command"
    ],
    "gitlens.graph.layout": "editor",
    "terminal.integrated.fontFamily": "monospace",
    "editor.minimap.enabled": false,
    "gitlens.views.commitDetails.files.layout": "list",
    "githubPullRequests.pullBranch": "never",
    "window.titleBarStyle": "custom",
    "plantuml.server": "https://www.plantuml.com/plantuml",
    "plantuml.render": "PlantUMLServer",
    "github.copilot.renameSuggestions.triggerAutomatically": false,
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.snippetSuggestions": "none",
    "geminicodeassist.inlineSuggestions.enableAuto": false,
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "cpp": false
    },
    "workbench.colorCustomizations": {
        "statusBar.background": "#1A1A1A",
        "statusBar.noFolderBackground": "#212121",
        "statusBar.debuggingBackground": "#263238"
    },
    "gitlens.autolinks": [
        {
            "prefix": "BFW-",
            "url": "https://dev.prusa3d.com/browse/BFW-<num>"
        }
    ],
    "hexeditor.columnWidth": 16,
    "hexeditor.showDecodedText": false,
    "hexeditor.defaultEndianness": "little",
    "hexeditor.inspectorType": "aside",
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "terminal.integrated.allowChords": false,
    "terminal.integrated.cursorBlinking": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "claudeCode.preferredLocation": "panel",
    "C_Cpp.default.cppStandard": "c++23",
    "clang-format.language.cpp.fallbackStyle": "Visual Studio",
    "files.watcherExclude": {
        "**/.bloop": true,
        "**/.metals": true
    },
    "latex-workshop.intellisense.biblatexJSON.replace": {
        
    },

  // 1. Give text breathing room
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.letterSpacing": 0.5,

  // 2. Choose a clean, legible programming font
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace",

  // 3. Improve color visibility & cursor tracking
  "terminal.integrated.minimumContrastRatio": 4.5,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "block",

  // 4. Smooth rendering & padding
  "terminal.integrated.gpuAcceleration": "on"
  
}
