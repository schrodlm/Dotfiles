#!/bin/sh
# Wrapper script invoked by the display manager instead of `sway` directly.
# Sets PATH and XDG_DATA_DIRS so sway-spawned children (rofi, exec spotify,
# etc.) can find Nix-installed apps. gdm starts sway with a minimal env that
# does NOT include systemd-user's environment.d additions; we fix that here.

export PATH="$HOME/.local/bin:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin}"
export XDG_DATA_DIRS="$HOME/.nix-profile/share:/nix/var/nix/profiles/default/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

exec sway "$@"
